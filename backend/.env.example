# Google Maps API key (debe tener habilitada: Distance Matrix API)
# Sin restricción de aplicación (la Cloud Function llama desde IPs dinámicas de GCP)
GOOGLE_MAPS_API_KEY=

# IPs con permiso para invocar la Cloud Function (separadas por coma)
# Ejemplo: 200.119.177.56,2800:98:1124:5b::1
ALLOWED_IPS=

# Project ID del proyecto de Firebase donde están los usuarios autenticados
FIREBASE_PROJECT_ID=

# Parámetros opcionales del algoritmo genético
GA_POPULATION_SIZE=120
GA_GENERATIONS=400
GA_MUTATION_RATE=0.08
